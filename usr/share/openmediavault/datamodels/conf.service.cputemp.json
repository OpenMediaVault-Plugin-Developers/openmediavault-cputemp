{
	"type": "config",
	"id": "conf.service.cputemp",
	"title": "CPU Temp",
	"queryinfo": {
		"xpath": ".//services/cputemp",
		"iterable": false
	},
	"properties": {
		"script": {
			"type": "string",
			"default": "#!/bin/sh\nfor z in /sys/class/thermal/thermal_zone*; do\n    [ \"$(cat \"$z/type\" 2>/dev/null)\" = \"x86_pkg_temp\" ] && exec cat \"$z/temp\"\ndone\nfor h in /sys/class/hwmon/hwmon*; do\n    [ \"$(cat \"$h/name\" 2>/dev/null)\" = \"k10temp\" ] && exec cat \"$h/temp1_input\"\ndone\ncat /sys/devices/virtual/thermal/thermal_zone0/temp"
		},
		"scriptpath": {
			"type": "string",
			"default": "/usr/sbin/cpu-temp"
		},
		"divisor": {
			"type": "integer",
			"minimum": 1,
			"default": 1000
		},
		"script2": {
			"type": "string",
			"default": ""
		},
		"scriptpath2": {
			"type": "string",
			"default": "/usr/sbin/cpu-temp2"
		},
		"divisor2": {
			"type": "integer",
			"minimum": 1,
			"default": 1000
		},
		"script3": {
			"type": "string",
			"default": ""
		},
		"scriptpath3": {
			"type": "string",
			"default": "/usr/sbin/cpu-temp3"
		},
		"divisor3": {
			"type": "integer",
			"minimum": 1,
			"default": 1000
		},
		"script4": {
			"type": "string",
			"default": ""
		},
		"scriptpath4": {
			"type": "string",
			"default": "/usr/sbin/cpu-temp4"
		},
		"divisor4": {
			"type": "integer",
			"minimum": 1,
			"default": 1000
		}
	}
}
